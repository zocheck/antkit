{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "apps/docs/public",
    "dist",
    "dist-ssr",
    "node_modules",
    "packages/react/skills/antkit-react/COMPONENTS.md",
    "packages/react/skills/antkit-react/catalogue.json",
    "yarn.lock"
  ]
}
